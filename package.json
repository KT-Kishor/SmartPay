{
  "name": "SmartPay",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.1",
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-smartpay": "cds watch --open smartpay.invoice.smartpay/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy SmartPay --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "john": {
            "password": "x",
            "roles": [
              "BUYER"
            ]
          },
          "supplier": {
            "password": "x",
            "roles": [
              "SUPPLIER_USER"
            ]
          },
          "admin": {
            "password": "x",
            "roles": [
              "ADMIN"
            ]
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      },
      "[hybrid]": {
        "db": {
          "kind": "hana"
        }
      },
      "destinations": true
    }
  },
  "workspaces": [
    "app/*"
  ]
}
