<mvc:View controllerName="smartpay.invoice.smartpay.controller.ManagePO"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form"
  xmlns:cg="sap.ui.layout.cssgrid"
  xmlns:sfi="sap.ui.comp.smartfield" xmlns:st="sap.ui.comp.smarttable">
  <Page showHeader="false" enableScrolling="true">
    <content>

      <!-- Title row: title block and actions wrap onto two lines on narrow screens -->
      <FlexBox wrap="Wrap" alignItems="Center" justifyContent="SpaceBetween" renderType="Div"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
        <VBox class="sapUiTinyMarginBottom">
          <layoutData><FlexItemData growFactor="1" baseSize="16rem"/></layoutData>
          <Title text="Manage PO" level="H3" titleStyle="H3" wrapping="true"/>
          <Text text="Create purchase orders, manage header and line item details, and send POs to suppliers."/>
        </VBox>

        <OverflowToolbar design="Transparent" width="auto" class="sapUiNoContentPadding">
          <layoutData><FlexItemData growFactor="0" shrinkFactor="1" minWidth="0"/></layoutData>
          <ObjectStatus text="{ui>/chipText}" state="{ui>/chipState}" inverted="true" icon="sap-icon://status-positive">
            <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
          </ObjectStatus>
          <Button id="saveDraftBtn" text="Save Draft" press=".onSaveDraft" enabled="{= !${ui>/locked}}">
            <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
          </Button>
          <Button id="messagePopoverBtn" icon="sap-icon://message-popup" type="Emphasized"
            visible="{= ${message>/}.length > 0 }"
            text="{= ${message>/}.length }" press=".onMessagesPress">
            <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
          </Button>
          <Button text="Preview" press=".onPreview" enabled="{ui>/saved}">
            <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
          </Button>
          <Button text="Send to Supplier" type="Transparent" press=".onSend"
            enabled="{= !${ui>/locked} &amp;&amp; ${ui>/saved}}">
            <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
          </Button>
        </OverflowToolbar>
      </FlexBox>

      <!-- PO Header Details: columns reflow automatically (1 column on phone, up to 4 on desktop) -->
      <Panel class="sapUiResponsiveMargin" width="auto">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="PO Header Details"/>
            <core:Icon src="sap-icon://hint"/>
            <ToolbarSpacer/>
            <Button text="Edit" type="Transparent" press=".onToggleEdit" visible="{= !${ui>/locked}}"/>
          </OverflowToolbar>
        </headerToolbar>

        <cg:CSSGrid
          width="auto"
          gridTemplateColumns="repeat(auto-fill, minmax(min(100%, 14rem), 1fr))"
          gridGap="0.75rem 1rem"
          class="sapUiSmallMarginBeginEnd">

          <VBox>
            <Label text="PO Number"/>
            <Input editable="false" value="{= ${poNumber} || ${ui>/poNumberPreview} }"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fSupplier"/>
            <sfi:SmartField id="fSupplier" value="{supplier_ID}" contextEditable="{ui>/edit}"
              innerControlsCreated=".onSupplierInner"/>
          </VBox>
          <VBox>
            <Label text="Supplier ID"/>
            <Input editable="false" value="{supplierExtId}"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fCompany"/>
            <sfi:SmartField id="fCompany" value="{company_ID}" contextEditable="{ui>/edit}"/>
          </VBox>

          <VBox>
            <sfi:SmartLabel labelFor="fOrg"/>
            <sfi:SmartField id="fOrg" value="{purchasingOrg_ID}" contextEditable="{ui>/edit}"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fPoDate"/>
            <sfi:SmartField id="fPoDate" value="{poDate}" contextEditable="{ui>/edit}"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fCurrency"/>
            <sfi:SmartField id="fCurrency" value="{currency_code}" contextEditable="{ui>/edit}"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fTerms"/>
            <sfi:SmartField id="fTerms" value="{paymentTerm_code}" contextEditable="{ui>/edit}"/>
          </VBox>

          <VBox>
            <sfi:SmartLabel labelFor="fDelivery"/>
            <sfi:SmartField id="fDelivery" value="{deliveryDate}" contextEditable="{ui>/edit}"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fShipTo"/>
            <sfi:SmartField id="fShipTo" value="{shipTo_ID}" contextEditable="{ui>/edit}"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fBuyer"/>
            <sfi:SmartField id="fBuyer" value="{buyer_ID}" contextEditable="{ui>/edit}"/>
          </VBox>
          <VBox>
            <sfi:SmartLabel labelFor="fPoType"/>
            <sfi:SmartField id="fPoType" value="{poType_code}" contextEditable="{ui>/edit}"/>
          </VBox>
        </cg:CSSGrid>
      </Panel>

      <!-- Line Items -->
      <Panel class="sapUiResponsiveMargin" width="auto">
        <OverflowToolbar design="Transparent">
          <Title text="Line Items ({ui>/lineCount})"/>
          <core:Icon src="sap-icon://hint"/>
          <ToolbarSpacer/>
          <Button text="Add Line Item"  type="Transparent" press=".onAddLine"
            enabled="{= !${ui>/locked}}">
            <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
          </Button>
          <Button text="Import" type="Transparent" press=".onImport" enabled="{= !${ui>/locked}}">
            <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
          </Button>
          <Button icon="sap-icon://overflow" type="Transparent" press=".onOverflow">
            <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
          </Button>
        </OverflowToolbar>

        <!-- NEW (unsaved) PO: lines held locally -->
        <Table id="draftLineTable" items="{draft>/rows}" visible="{ui>/isNew}"
          popinLayout="GridSmall" contextualWidth="Auto"
          noDataText="No line items yet. Click Add Line Item.">
          <columns>
            <Column importance="High" hAlign="End" width="4rem"><Text text="Line"/></Column>
            <Column importance="High" minScreenWidth="Tablet" demandPopin="true"><Text text="Material / Service"/></Column>
            <Column importance="Medium" minScreenWidth="Tablet" demandPopin="true"><Text text="Description"/></Column>
            <Column importance="High" hAlign="End"><Text text="Qty"/></Column>
            <Column importance="Low" minScreenWidth="Desktop" demandPopin="true"><Text text="UOM"/></Column>
            <Column importance="Medium" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Unit Price"/></Column>
            <Column importance="Low" minScreenWidth="Desktop" demandPopin="true"><Text text="Delivery Date"/></Column>
            <Column importance="Low" minScreenWidth="Desktop" demandPopin="true"><Text text="Plant / Location"/></Column>
            <Column importance="High" hAlign="End"><Text text="Amount"/></Column>
            <Column importance="High" hAlign="End" width="6rem"><Text text="Actions"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{draft>lineNumber}"/>
                <Text text="{draft>materialCode}"/>
                <Text text="{draft>description}"/>
                <Text text="{path:'draft>orderedQuantity', formatter:'.formatter.qty'}"/>
                <Text text="{draft>uom}"/>
                <Text text="{parts:[{path:'draft>unitPrice'},{path:'ui>/currency'}], formatter:'.formatter.money2'}"/>
                <Text text="{draft>deliveryDate}"/>
                <Text text="{draft>plant}"/>
                <Text text="{parts:[{path:'draft>lineValue'},{path:'ui>/currency'}], formatter:'.formatter.money2'}"/>
                <HBox justifyContent="End">
                  <Button icon="sap-icon://edit" type="Transparent" press=".onEditDraftLine"/>
                  <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteDraftLine"/>
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <!-- SAVED PO: SmartTable. Its generated columns (Line, Material, Description, UOM,
             Delivery Date, Plant) get their importance from @UI.Importance in the annotations. -->
        <st:SmartTable id="lineTable" entitySet="POLines" tableBindingPath="lines" tableType="ResponsiveTable"
          visible="{= !${ui>/isNew}}" useExportToExcel="false"
          enableAutoBinding="true" useVariantManagement="false" useTablePersonalisation="false" showRowCount="false"
          requestAtLeastFields="ID,po_ID,taxRate,lineNumber">
          <Table popinLayout="GridSmall" contextualWidth="Auto" updateFinished=".onLinesUpdated">
            <columns>
              <Column importance="High" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                <customData><core:CustomData key="p13nData" value='\{"columnKey":"qty","leadingProperty":"orderedQuantity","sortProperty":"orderedQuantity","columnIndex":"3"}'/></customData>
                <Text text="Qty"/>
              </Column>
              <Column importance="Medium" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                <customData><core:CustomData key="p13nData" value='\{"columnKey":"price","leadingProperty":"unitPrice","sortProperty":"unitPrice","columnIndex":"5"}'/></customData>
                <Text text="Unit Price"/>
              </Column>
              <Column importance="High" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                <customData><core:CustomData key="p13nData" value='\{"columnKey":"amount","leadingProperty":"lineValue","sortProperty":"lineValue","columnIndex":"8"}'/></customData>
                <Text text="Amount"/>
              </Column>
              <Column importance="High" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                <customData><core:CustomData key="p13nData" value='\{"columnKey":"actions","leadingProperty":"ID","columnIndex":"9"}'/></customData>
                <Text text="Actions"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{path:'orderedQuantity', formatter:'.formatter.qty'}"/>
                  <Text text="{parts:[{path:'unitPrice'},{path:'ui>/currency'}], formatter:'.formatter.money2'}"/>
                  <Text text="{parts:[{path:'lineValue'},{path:'ui>/currency'}], formatter:'.formatter.money2'}"/>
                  <HBox justifyContent="End">
                    <Button icon="sap-icon://edit" type="Transparent" press=".onEditLine" enabled="{= !${ui>/locked}}"/>
                    <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteLine" enabled="{= !${ui>/locked}}"/>
                  </HBox>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </st:SmartTable>

        <!-- Totals: wrap and right-align -->
        <FlexBox justifyContent="End" alignItems="Center" wrap="Wrap" renderType="Bare"
          class="sapUiSmallMarginTop">
          <VBox alignItems="End" class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
            <Label text="Subtotal"/>
            <ObjectNumber number="{parts:[{path:'ui>/subtotal'},{path:'ui>/currency'}], formatter:'.formatter.money2'}"/>
          </VBox>
          <VBox alignItems="End" class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
            <Label text="{parts:[{path:'ui>/subtotal'},{path:'ui>/tax'}], formatter:'.formatter.taxLabel'}"/>
            <ObjectNumber number="{parts:[{path:'ui>/tax'},{path:'ui>/currency'}], formatter:'.formatter.money2'}"/>
          </VBox>
          <VBox alignItems="End" class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
            <Label text="Total PO Value"/>
            <ObjectNumber emphasized="true"
              number="{parts:[{path:'ui>/total'},{path:'ui>/currency'}], formatter:'.formatter.money2'}"/>
          </VBox>
        </FlexBox>
      </Panel>

      <!-- Supplier Delivery / E2E Flow + Supplier Communication: side by side on desktop, stacked on phone -->
      <FlexBox wrap="Wrap" alignItems="Stretch" renderType="Div"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

        <Panel width="auto" class="sapUiTinyMarginTop sapUiTinyMarginBottom sapUiTinyMarginEnd">
          <layoutData><FlexItemData growFactor="3" baseSize="22rem"/></layoutData>
          <headerToolbar>
            <OverflowToolbar><Title text="Supplier Delivery / E2E Flow"/><core:Icon src="sap-icon://hint"/></OverflowToolbar>
          </headerToolbar>
          <FlexBox items="{flow>/steps}" wrap="Wrap" justifyContent="SpaceAround" alignItems="Start" renderType="Div">
            <VBox alignItems="Center" class="sapUiTinyMargin" width="9rem">
              <HBox alignItems="Center">
                <Avatar displaySize="XS" displayShape="Circle"
                  src="{= ${flow>done} ? 'sap-icon://accept' : '' }" initials="{flow>n}"
                  backgroundColor="{= ${flow>done} ? 'Accent6' : 'Placeholder' }"/>
                <core:Icon src="sap-icon://slim-arrow-right" class="sapUiTinyMarginBegin" visible="{= ${flow>n} !== 4}"/>
              </HBox>
              <Title text="{flow>n}. {flow>title}" level="H6" wrapping="true" textAlign="Center" class="sapUiTinyMarginTop"/>
              <Text text="{flow>date}"/>
              <Text text="{flow>time}"/>
            </VBox>
          </FlexBox>
        </Panel>

        <Panel width="auto" class="sapUiTinyMarginTop sapUiTinyMarginBottom">
          <layoutData><FlexItemData growFactor="2" baseSize="18rem"/></layoutData>
          <headerToolbar>
            <OverflowToolbar><Title text="Supplier Communication"/><core:Icon src="sap-icon://hint"/></OverflowToolbar>
          </headerToolbar>
          <MessageStrip type="Success" showIcon="true" enableFormattedText="true"
            text="&lt;strong>PO sent successfully to supplier.&lt;/strong>&lt;br>The purchase order has been transmitted via Supplier Portal."
            visible="{= ${flow>/comm/status} === 'SENT'}"/>
          <MessageStrip type="Error" showIcon="true" text="{flow>/comm/error}"
            visible="{= ${flow>/comm/status} === 'FAILED'}"/>
          <f:SimpleForm editable="false" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1"
            adjustLabelSpan="false" labelSpanS="12" labelSpanM="12">
            <Label text="Delivery Channel"/><Text text="{flow>/comm/channel}"/>
            <Label text="Sent To"/><Text text="{flow>/comm/sentTo}"/>
            <Label text="Last Sent"/><Text text="{flow>/comm/sentAt}"/>
            <Label text="Transmission Status"/>
            <ObjectStatus text="{flow>/comm/statusText}"
              state="{= ${flow>/comm/status} === 'SENT' ? 'Success' : (${flow>/comm/status} === 'FAILED' ? 'Error' : 'Warning') }"
              icon="sap-icon://circle-task-2"/>
          </f:SimpleForm>
        </Panel>
      </FlexBox>

    </content>
  </Page>
</mvc:View>